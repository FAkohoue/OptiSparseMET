# RStudio project files
^.*\.Rproj$
^\.Rproj\.user$

# Git and GitHub
^\.git$
^\.github$
^\.gitignore$

# Saved workspace / history and the extension-less README source
# (kept out of the built tarball so R CMD check stays NOTE-free).
^\.RData$
^\.Rhistory$
^README$

# Local agent/workspace metadata must never enter a source package
^\.codex$
^\.agents$

# pkgdown site configuration and assets
# _pkgdown.yml is excluded to avoid a CRAN note about non-standard files.
# This does not break pkgdown: the site is built from the repo, not the tarball.
^_pkgdown\.yml$
^pkgdown$

# Built pkgdown site output
^docs$

# Private scenarios and data-generation scripts (not distributed)
^data-raw$
^scenarios$
^private$

# Ad-hoc and maintenance scripts
^scripts$

# CRAN submission notes
^cran-comments\.md$

# Development / analysis documents (not part of the installed package)
^CRITIQUE_Colmant2026_and_OptiSparseMET\.md$
^DECISION_POINTS_DESIGN\.md$
^IMPLEMENTATION_PLAN\.md$
^VALIDATION\.md$

# Private reference PDFs and editable guides kept for development
^Colmant et al\. 2026\.pdf$
^Montesinos-Lopez et al\. 2023\.pdf$
^Mothukuri et al 2025\.pdf$
^Soilgrid_.*\.pdf$
\.docx$
# Root-level PDFs remain development copies. The public breeder guide is
# distributed separately from inst/guides/.
^[^/]+\.pdf$

# Office lock/temp artefacts. Word writes "~$<name>.docx" and "~WRL####.tmp"
# while a document is open; R CMD check cannot read the locked file and halts
# during "checking for executable files".
^~\$
^~WRL.*\.tmp$
\.tmp$

# License and README source files
^LICENSE\.md$
^README\.Rmd$

# Auto-generated directories created by R CMD build / devtools::build()
# These appear in the source tree during development but must not be
# included in the distributed tarball.
^doc$
^Meta$
